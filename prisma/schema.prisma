generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  password         String
  role             String   @default("employee") // "admin" or "employee"
  overtimeBalance  Int      @default(0) // 先月までの過不足労働時間（分単位）
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attendances Attendance[]
  dayOffs     DayOff[]
}

model Attendance {
  id             String    @id @default(cuid())
  userId         String
  date           String    // YYYY-MM-DD
  clockIn        DateTime?
  clockOut       DateTime?
  breakStart     DateTime?
  breakEnd       DateTime?
  workDuration   Int?      // minutes
  breakDuration  Int?      // minutes
  note           String?
  modifiedBy     String?   // admin who modified
  modifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model DayOff {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  type      String   // "休み", "有給", "午前休", "午後休", "特別休暇"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
